# Valkey connection
BETTERDB_VALKEY_URL=redis://localhost:6390
BETTERDB_VALKEY_INDEX_NAME=betterdb-memory-index

# Embedding provider
# Leave everything below unset for zero-config on-device embeddings
# (all-MiniLM-L6-v2, 384-dim) — no API key, no service. Weights download
# once on first use. Set BETTERDB_EMBED_PROVIDER to force a specific provider.
# BETTERDB_EMBED_PROVIDER=local   # local | ollama | openai | voyage | groq | together

# Ollama (used when models are installed, or via BETTERDB_EMBED_PROVIDER=ollama)
BETTERDB_OLLAMA_URL=http://localhost:11434
BETTERDB_EMBED_MODEL=mxbai-embed-large
BETTERDB_SUMMARIZE_MODEL=mistral:7b
BETTERDB_EMBED_DIM=1024

# Memory settings
BETTERDB_MAX_CONTEXT_MEMORIES=5
BETTERDB_DECAY_RATE=0.95
BETTERDB_COMPRESS_THRESHOLD=0.3
BETTERDB_DISTILL_MIN_SESSIONS=5
BETTERDB_CONTEXT_FILE=.betterdb_context.md
BETTERDB_AGING_INTERVAL_HOURS=6

# Recall gating (over-fetch → relevance gate → narrow; escalates on a miss)
# tau_* are cosine-similarity thresholds (0..1). Calibrate against the
# LongMemEval harness: the highest tau that keeps recall@k at baseline.
BETTERDB_RECALL_TAU_HIGH=0.55
BETTERDB_RECALL_TAU_LOW=0.35
BETTERDB_RECALL_POOL_K=10
BETTERDB_RECALL_POOL_K_WIDE=20
BETTERDB_ALLOW_CROSS_PROJECT=true

# Remote fallback (optional)
BETTERDB_ALLOW_REMOTE_FALLBACK=true
# OPENAI_API_KEY=sk-...
